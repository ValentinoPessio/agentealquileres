# Copiar a .env y completar. NUNCA commitear el .env real.

# --- Proveedor de LLM ---
# gemini (default) | lmstudio
LLM_PROVIDER=gemini

# Clave de Google AI Studio (https://aistudio.google.com -> Get API key)
GOOGLE_API_KEY=

# Modelo de chat de Gemini. Verifiquen en AI Studio / en la documentación de
# razonamiento de Google qué modelos con tool calling y razonamiento tienen
# disponibles en el tier gratuito, y completen el nombre exacto.
GEMINI_MODEL=

# Modelos de respaldo, separados por coma y en orden. Si el principal agota su cuota
# diaria gratuita (429 RESOURCE_EXHAUSTED), el agente prueba con estos. Cada modelo
# tiene su propia cuota. Ejemplo: GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=

# Modelo de embeddings (para el RAG)
EMBEDDING_MODEL=gemini-embedding-001

# Reintentos ante errores transitorios / 429
LLM_MAX_RETRIES=2

# --- Solo si LLM_PROVIDER=lmstudio ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# --- API de índices (se completan más adelante) ---
INDEC_API_TOKEN=
